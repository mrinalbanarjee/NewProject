# MongoDB Atlas connection string. Vector Search requires an Atlas cluster with a
# vector index configured on the issue-catalog collection - a self-hosted/community
# Mongo instance (e.g. the one TriageApi.Api points at) will not work for this.
MONGO_ATLAS_CONNECTION_STRING=
MONGO_ATLAS_DATABASE_NAME=
MONGO_ATLAS_ISSUE_CATALOG_COLLECTION=IssueCatalog
MONGO_ATLAS_VECTOR_INDEX_NAME=issue_catalog_vector_index

# Embeddings provider. Defaults to Voyage AI (Anthropic's recommended embeddings
# partner) - swap the concrete implementation in embeddings.py if you'd rather use
# something else; nothing else in the service depends on which one.
VOYAGE_API_KEY=
