# All optional - the chat UI lets each user paste their own key per-provider
# (bring-your-own-token, stored in their browser only). These are just a
# server-side fallback for local dev, used only when a request doesn't supply
# its own key. Set whichever provider(s) you use.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CLI only - the web UI's provider dropdown/API-key field make these irrelevant there.
# COMPARE_AGENT_PROVIDER=google
# COMPARE_AGENT_API_KEY=

# Optional per-provider, per-tier model overrides (see router.py for defaults/fallback behavior)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_REASONING_MODEL=gpt-4o
# GOOGLE_FAST_MODEL=gemini-3.6-flash
# GOOGLE_REASONING_MODEL=gemini-3.6-pro
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_REASONING_MODEL=claude-sonnet-5

# Optional - point at fresher exports instead of the bundled data/ fixtures
# COMPARE_RESULTS_PATH=/path/to/customercompareresults.json
# BOARDING_STATUS_PATH=/path/to/HoganAccountBoardingStatusResponse.json
# FAILURE_LIST_PATH=/path/to/FailureListResponse.json
